<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test method names describe behavior in prose; CA1707 forbids underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Blanky.Core\Blanky.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Blanky\Assets\sounds.json" Link="Assets\sounds.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Blanky\Assets\icons.json" Link="Assets\icons.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
