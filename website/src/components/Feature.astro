---
import Icon from "./Icon.astro";
import Screenshot from "./Screenshot.astro";

interface Item {
  icon: string;
  title: string;
  text: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  items: Item[];
  image: string;
  alt: string;
  reverse?: boolean;
}

const { eyebrow, title, lede, items, image, alt, reverse = false } = Astro.props;
---

<section class:list={["feature", { reverse }]}>
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="display" set:html={title} />
      <p class="lede">{lede}</p>
      <ul>
        {
          items.map((item) => (
            <li>
              <Icon name={item.icon} size={22} class="item-icon" />
              <div>
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="media">
      <Screenshot src={image} alt={alt} />
    </div>
  </div>
</section>

<style>
  .feature {
    padding: 96px 0;
  }
  .feature + :global(.feature) {
    border-top: 1px solid var(--hair-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: 56px;
    align-items: center;
  }
  .reverse .grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
  }
  .reverse .copy {
    order: 2;
  }
  h2 {
    font-size: clamp(34px, 4.4vw, 46px);
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  li :global(.item-icon) {
    flex: none;
    margin-top: 1px;
    color: var(--accent-ink);
  }
  li strong {
    display: block;
    font-size: 17px;
  }
  li span {
    display: block;
    color: var(--fg-2);
    font-size: 15px;
    margin-top: 2px;
  }
  @media (max-width: 860px) {
    .feature {
      padding: 64px 0;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .reverse .grid {
      grid-template-columns: 1fr;
    }
    .reverse .copy {
      order: 0;
    }
  }
</style>
