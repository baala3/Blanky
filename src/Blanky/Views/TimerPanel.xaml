<UserControl
    x:Class="Blanky.Views.TimerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blanky.Views">

    <Grid Width="280" Padding="8" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FontIcon
            HorizontalAlignment="Center"
            FontSize="44"
            Foreground="{ThemeResource BlankyAccentBrush}"
            Glyph="&#xE916;" />

        <!-- Not running: choose a duration. -->
        <StackPanel
            x:Name="Setup"
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">
            <NumberBox
                x:Name="Hours"
                Width="104"
                Header="Hours"
                LargeChange="1"
                Maximum="23"
                Minimum="0"
                SpinButtonPlacementMode="Inline"
                Value="0" />
            <NumberBox
                x:Name="Minutes"
                Width="104"
                Header="Minutes"
                LargeChange="15"
                Maximum="59"
                Minimum="0"
                SmallChange="5"
                SpinButtonPlacementMode="Inline"
                Value="30" />
        </StackPanel>

        <!-- Running: countdown and adjustments. -->
        <StackPanel
            x:Name="Running"
            Grid.Row="1"
            HorizontalAlignment="Center"
            Spacing="4"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="34"
                FontWeight="SemiBold"
                Text="{x:Bind local:Ui.Countdown(Timer.Remaining), Mode=OneWay}" />
            <TextBlock
                x:Name="EndsAtText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Button
            x:Name="StartButton"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Click="OnStart"
            Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE768;" />
                <TextBlock Text="Start Timer" />
            </StackPanel>
        </Button>
        <Grid
            x:Name="RunningButtons"
            Grid.Row="2"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Stretch" Click="OnAddTime" Content="+15 min" />
            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="OnCancel"
                Content="Cancel Timer" />
        </Grid>

        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="Blanky will pause when the timer ends" />
    </Grid>
</UserControl>
